<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClipboardMerge</AssemblyName>
    <RootNamespace>ClipboardMerge</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Voidream</Authors>
    <Description>Lightweight clipboard copy feedback and merge mode for Windows.</Description>
  </PropertyGroup>
</Project>
